<mah:MetroWindow x:Class="AetherSystem.OperationReport.Gui.Features.Main.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:AetherSystem.OperationReport.Gui.Features.Main"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="{Binding TitleText}"
        CornerPreference="DoNotRound"
        ShowIconOnTitleBar="True"
        Width="1024" Height="768"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TitleForeground="{DynamicResource MahApps.Brushes.Gray10}"
        d:DesignWidth="800" d:DesignHeight="600">

  <mah:MetroWindow.Resources>
    <DataTemplate DataType="{x:Type local:BlankViewModel}">
      <local:BlankView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:LoadingViewModel}">
      <local:LoadingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:DashboardViewModel}">
      <local:DashboardView />
    </DataTemplate>
  </mah:MetroWindow.Resources>

  <mah:MetroWindow.IconTemplate>
    <DataTemplate>
      <i:PackIconMaterial
        Kind="ChartArc"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource MahApps.Brushes.IdealForeground}" />
    </DataTemplate>
  </mah:MetroWindow.IconTemplate>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ToolBarTray Grid.Row="0">
      <ToolBar>
        <Button Command="{Binding CreatePresetCommand}" Padding="5 2">
          <StackPanel Orientation="Horizontal">
            <i:Material Kind="File" />
            <TextBlock Text="New" Margin="3 0" />
          </StackPanel>
        </Button>
        <Button Command="{Binding OpenPresetCommand}" Padding="5 2">
          <StackPanel Orientation="Horizontal">
            <i:Material Kind="FileMoveOutline" />
            <TextBlock Text="Open" Margin="3 0" />
          </StackPanel>
        </Button>
        <Button  Command="{Binding SavePresetCommand}" Padding="5 2">
          <StackPanel Orientation="Horizontal">
            <i:Material Kind="ContentSave" />
            <TextBlock Text="Save" Margin="3 0" />
          </StackPanel>
        </Button>
      </ToolBar>
    </ToolBarTray>

    <ContentControl Grid.Row="1" Content="{Binding CurrentContent}" />

    <StatusBar Grid.Row="2" 
               BorderThickness="0 1 0 0"
               BorderBrush="{StaticResource MahApps.Brushes.Gray2}"
               Padding="5 0"
               Background="{StaticResource MahApps.Brushes.Gray1}"
               Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <mah:MetroProgressBar Value="0.5" Minimum="0" Maximum="1"
                              Visibility="Visible"
                              VerticalAlignment="Center"
                              Width="100" Foreground="{StaticResource MahApps.Brushes.Gray10}"/>
        <TextBlock VerticalAlignment="Center"
                   Margin="5 0"/>
      </StackPanel>
    </StatusBar>
  </Grid>
</mah:MetroWindow>
