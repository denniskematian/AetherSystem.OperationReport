<UserControl x:Class="AetherSystem.OperationReport.Gui.Features.Main.SampleDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AetherSystem.OperationReport.Gui.Features.Main"
             xmlns:behaviors="clr-namespace:AetherSystem.OperationReport.Gui.Behaviors"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SampleDataViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="10 8">
      <StackPanel DockPanel.Dock="Left"
                  Orientation="Horizontal"
                  HorizontalAlignment="Left">
        <mah:SplitButton ItemsSource="{Binding Context.FilterQueries}"
                         SelectedItem="{Binding Context.FilterQuery}"
                         Command="{Binding ChangeFilterCommand}">
          <mah:SplitButton.Icon>
            <iconPacks:PackIconMaterial Margin="6" Kind="Filter" />
          </mah:SplitButton.Icon>
        </mah:SplitButton>
      </StackPanel>
      <UserControl/>
    </DockPanel>

    <DataGrid Grid.Row="1" Grid.Column="0"
              AutoGenerateColumns="False"
              ItemsSource="{Binding Rows}"
              behaviors:SampleDataGridBehavior.SampleSource="{Binding Context.PresetConfig.SampleReferences}"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              SelectionMode="Single"
              CanUserSortColumns="False"
              CanUserReorderColumns="False"
              GridLinesVisibility="All"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              HorizontalGridLinesBrush="{StaticResource MahApps.Brushes.Gray7}"
              VerticalGridLinesBrush="{StaticResource MahApps.Brushes.Gray7}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto" />

    <StackPanel Grid.Row="2" Grid.Column="0" Margin="10 8"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <TextBlock VerticalAlignment="Center" Margin="4 0" 
                 Text="{Binding TotalRows, StringFormat={}{0:N0} rows}" />
      <Button Content="Previous" Width="72" 
              Command="{Binding PreviousPageCommand}" />
      <TextBox Width="40" TextAlignment="Center" AcceptsReturn="False" AcceptsTab="False" 
               Text="{Binding CurrentPage, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter"
                      Command="{Binding ChangePageCommand}"
                      CommandParameter="{Binding CurrentPage}" />
        </TextBox.InputBindings>
      </TextBox>
      <Button Content="Next" Width="72"
              Command="{Binding NextPageCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
