<mah:MetroWindow x:Class="AetherSystem.OperationReport.Gui.Features.ChartSettingDialog.ChartSettingView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:AetherSystem.OperationReport.Gui.Features.ChartSettingDialog"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:converters="clr-namespace:AetherSystem.OperationReport.Gui.Converters"
                 Title="Configure Axis" Height="450" Width="800"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 CornerPreference="DoNotRound"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance local:ChartSettingViewModel}"
                 d:DesignHeight="800" d:DesignWidth="600">
  <mah:MetroWindow.Resources>
    <ResourceDictionary>
      <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    </ResourceDictionary>
  </mah:MetroWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    
    <Grid Grid.Row="0" Margin="10 8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Label Grid.Row="0" Grid.Column="0"
             Content="Bottom Axis"
             VerticalAlignment="Center"
             Margin="0" />
      <CheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                Margin="5 2"
                IsChecked="{Binding ShowDateInBottomTicks}"
                Content="Show Date" />

      <Label Grid.Row="1" Grid.Column="0"
             Content="Left Axis"
             VerticalAlignment="Center"
             Margin="0" />
      <CheckBox Grid.Row="1" Grid.Column="1"
                Margin="5 2"
                IsChecked="{Binding LeftAxis.IsVisible}"
                Content="Show" />
      <TextBox Grid.Row="1" Grid.Column="2"
               Margin="5 2 0 2"
               Text="{Binding LeftAxis.Label}"
               IsEnabled="{Binding LeftAxis.IsVisible}" />

      <Label Grid.Row="3" Grid.Column="0"
             Content="Operation Marker"
             VerticalAlignment="Center"
             Margin="0" />
      <CheckBox Grid.Row="3" Grid.Column="1"
                Margin="5 2"
                IsChecked="{Binding OperationMarker.IsVisible}"
                Content="Show" />
      
      <Grid Grid.Row="3" Grid.Column="2" Margin="5 2 5 2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding SeriesColumns}"
                  SelectedItem="{Binding OperationMarker.Column}"
                  IsEnabled="{Binding OperationMarker.IsVisible}"/>
        <Label Grid.Column="1"
               Content="Shape"
               VerticalAlignment="Center"
               Margin="5 2" />
        <ComboBox Grid.Column="2"
                  ItemsSource="{x:Static local:Options.MarkerShapeOptions}"
                  IsEnabled="{Binding OperationMarker.IsVisible}"
                  SelectedValue="{Binding OperationMarker.Shape}"
                  SelectedValuePath="Value"
                  DisplayMemberPath="Name"/>
        <Label Grid.Column="3"
               Content="Color"
               VerticalAlignment="Center"
               Margin="5 2" />
        <ComboBox Grid.Column="4"
                  IsEnabled="{Binding OperationMarker.IsVisible}"
                  ItemsSource="{x:Static local:Options.ColorOptions}"
                  SelectedItem="{Binding OperationMarker.Color}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Border Width="12" Height="12" Margin="0,0,4,0"
                        Background="{Binding Value, Converter={StaticResource ColorToBrushConverter}}" />
                <TextBlock Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Label Grid.Row="2" Grid.Column="0"
             Content="Right Axis"
             Margin="0" />
      <CheckBox Grid.Row="2" Grid.Column="1"
                Margin="5 2"
                IsChecked="{Binding RightAxis.IsVisible}" 
                Content="Show" />
      <TextBox Grid.Row="2" Grid.Column="2"
               Margin="5 2 0 2"
               Text="{Binding RightAxis.Label}" 
               IsEnabled="{Binding RightAxis.IsVisible}"/>

      <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
              Margin="0 5 0 0"
              BorderThickness="1"
              BorderBrush="{DynamicResource MahApps.Brushes.Accent}">
        <DataGrid SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  ItemsSource="{Binding Series}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsVisible, Mode=TwoWay}" />
            <DataGridTextColumn IsReadOnly="True" Header="Source" Binding="{Binding Column, Mode=OneTime}" />
            <DataGridTextColumn Header="Label" Binding="{Binding Label}" />
            <DataGridComboBoxColumn
              Header="Axis"
              ItemsSource="{Binding Source={x:Static local:Options.AxisPositionOptions}}"
              SelectedItemBinding="{Binding AxisPosition}"/>
            <DataGridComboBoxColumn
              Header="Style"
              ItemsSource="{Binding Source={x:Static local:Options.LinePatternOptions}}"
              SelectedItemBinding="{Binding LinePattern}"
              DisplayMemberPath="Name" />
            <DataGridTemplateColumn Header="Color">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="12" Height="12" Margin="0,0,4,0"
                            Background="{Binding Color.Value, Converter={StaticResource ColorToBrushConverter}}" />
                    <TextBlock Text="{Binding Color.Name}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox ItemsSource="{Binding Source={x:Static local:Options.ColorOptions}}"
                            SelectedItem="{Binding Color}"
                            DisplayMemberPath="Name">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="16" Height="16" Margin="0,0,6,0"
                                  Background="{Binding Value, Converter={StaticResource ColorToBrushConverter}}" />
                          <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
    <Separator Grid.Row="1" />
    <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                Margin="10 8"
                HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="5 0 0 0" />
      <Button Content="OK" IsDefault="True" Margin="5 0 0 0"
              Style="{DynamicResource MahApps.Styles.Button.Flat.Accent}"
              Command="{Binding ConfirmCommand}" />
    </StackPanel>
  </Grid>
</mah:MetroWindow>
