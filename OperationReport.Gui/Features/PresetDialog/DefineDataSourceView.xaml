<UserControl x:Class="AetherSystem.OperationReport.Gui.Features.PresetDialog.DefineDataSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AetherSystem.OperationReport.Gui.Features.PresetDialog"
             xmlns:converters="clr-namespace:AetherSystem.OperationReport.Gui.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vo="clr-namespace:AetherSystem.OperationReport.DataSources;assembly=OperationReport"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DefineDataSourceViewModel}"
             d:DesignHeight="400" d:DesignWidth="400">
  <UserControl.Resources>
    <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <converters:NegationBooleanConverter x:Key="NegationBooleanConverter" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Vertical" Margin="10 8">
      <TextBlock Text="Sample Data Source" FontSize="14" FontWeight="Medium"/>
      <StackPanel Orientation="Vertical" Margin="0 8 0 10">
        <StackPanel Orientation="Horizontal">
          <Label Content="File type" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <RadioButton
            GroupName="SampleDataSource" Content="SQLite" Margin="5 0 0 0"
            IsChecked="{Binding Context.SampleDataSource.FileType, 
                                Converter={StaticResource EnumToBooleanConverter}, 
                                ConverterParameter={x:Static vo:FileType.Sqlite}}" />
          <RadioButton
            GroupName="SampleDataSource" Content="CSV" Margin="5 0 0 0"
            IsChecked="{Binding Context.SampleDataSource.FileType, 
                                Converter={StaticResource EnumToBooleanConverter}, 
                                ConverterParameter={x:Static vo:FileType.Csv}}" />
        </StackPanel>

        <DockPanel>
          <Button DockPanel.Dock="Right"
                  ToolTip="Open file"
                  Command="{Binding OpenFileCommand}"
                  CommandParameter="Sample">
            <iconPacks:Material Kind="FolderArrowUp" />
          </Button>
          <TextBox Text="{Binding Context.SampleDataSource.FilePath}" />
        </DockPanel>
      </StackPanel>
      
      <TextBlock Text="Reference Data Source" FontSize="14" FontWeight="Medium"/>
      <StackPanel Orientation="Vertical" Margin="0 8 0 10">
        <CheckBox Content="Same as sample data source"
                  IsChecked="{Binding SampleIncludesReferenceDataSource}" />
        <StackPanel Orientation="Horizontal">
          <Label Content="File type" VerticalAlignment="Center" />
          <RadioButton
            GroupName="ReferenceDataSource" Content="SQLite" Margin="5 0 0 0"
            IsEnabled="{Binding SampleIncludesReferenceDataSource, Converter={StaticResource NegationBooleanConverter}}"
            IsChecked="{Binding Context.ReferenceDataSource.FileType, 
                                Converter={StaticResource EnumToBooleanConverter}, 
                                ConverterParameter={x:Static vo:FileType.Sqlite}}" />
          <RadioButton
            GroupName="ReferenceDataSource" Content="CSV" Margin="5 0 0 0"
            IsEnabled="{Binding SampleIncludesReferenceDataSource, Converter={StaticResource NegationBooleanConverter}}"
            IsChecked="{Binding Context.ReferenceDataSource.FileType, 
                                Converter={StaticResource EnumToBooleanConverter}, 
                                ConverterParameter={x:Static vo:FileType.Csv}}" />
        </StackPanel>

        <DockPanel>
          <Button DockPanel.Dock="Right"
                  ToolTip="Open file"
                  IsEnabled="{Binding SampleIncludesReferenceDataSource, Converter={StaticResource NegationBooleanConverter}}"
                  Command="{Binding OpenFileCommand}"
                  CommandParameter="Reference">
            <iconPacks:Material Kind="FolderArrowUp" />
          </Button>
          <TextBox Text="{Binding Context.ReferenceDataSource.FilePath}"
                   IsEnabled="{Binding SampleIncludesReferenceDataSource, Converter={StaticResource NegationBooleanConverter}}" />
        </DockPanel>

      </StackPanel>

      <TextBlock Text="Operation Data Source" FontSize="14" FontWeight="Medium"/>
      <StackPanel Orientation="Vertical" Margin="0 8 0 10">
        <StackPanel Orientation="Horizontal">
          <Label Content="File type" VerticalAlignment="Center"/>
          <RadioButton
            GroupName="OperationDataSource" Content="SQLite" Margin="5 0 0 0"
            Style="{StaticResource MahApps.Styles.RadioButton.Win10}"
            IsChecked="{Binding Context.OperationDataSource.FileType, 
                                Converter={StaticResource EnumToBooleanConverter}, 
                                ConverterParameter={x:Static vo:FileType.Sqlite}}" />
          <RadioButton
            GroupName="OperationDataSource" Content="CSV" Margin="5 0 0 0"
            Style="{StaticResource MahApps.Styles.RadioButton.Win10}"
            IsChecked="{Binding Context.OperationDataSource.FileType, 
                                Converter={StaticResource EnumToBooleanConverter}, 
                                ConverterParameter={x:Static vo:FileType.Csv}}" />
        </StackPanel>

        <DockPanel>
          <Button DockPanel.Dock="Right"
                  ToolTip="Open file"
                  Command="{Binding OpenFileCommand}"
                  CommandParameter="Operation">
            <iconPacks:Material Kind="FolderArrowUp" />
          </Button>
          <TextBox Text="{Binding Context.OperationDataSource.FilePath}" />
        </DockPanel>
      </StackPanel>
      
    </StackPanel>
  </ScrollViewer>
