<mah:MetroWindow x:Class="AetherSystem.OperationReport.Gui.Features.PresetDialog.PresetDialogView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:local="clr-namespace:AetherSystem.OperationReport.Gui.Features.PresetDialog"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=local:PresetDialogViewModel}"
                 
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 Title="{Binding TitleText}"
                 BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                 BorderThickness="1"
                 Height="720" Width="480"
                 MinHeight="600" MinWidth="400">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ContentControl Content="{Binding CurrentContent}" Margin="10 8" />
    </ScrollViewer>
    <Separator Grid.Row="1" />
    <DockPanel Grid.Row="2" Margin="10 8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Margin="3 0" Content="{Binding PreviousText}"
                Command="{Binding PreviousPageCommand}" />
        <Button Margin="3 0" Content="{Binding NextText}"
                Command="{Binding CurrentContent.ProceedCommand}"/>
      </StackPanel>
      <ProgressBar DockPanel.Dock="Left" Width="100" Height="10" IsIndeterminate="True"
                   Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding ProcessingMessage}" VerticalAlignment="Center" Margin="3 0" />
    </DockPanel>
  </Grid>
</mah:MetroWindow>
